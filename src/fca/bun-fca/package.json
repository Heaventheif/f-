{
  "name": "bun-fca",
  "version": "1.0.0",
  "description": "Unified, hardened Facebook Messenger API (FCA) engine for Node.js & Bun — dual CJS/ESM, 2 runtime dependencies, session guard, broadcast, scheduler, page webhooks",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "module/",
    "func/",
    "src/",
    "examples/",
    "README.md",
    "README.AR.md",
    "LICENSE"
  ],
  "scripts": {},
  "keywords": [
    "fca",
    "facebook",
    "messenger",
    "chat-api",
    "bot",
    "chatbot",
    "bun",
    "mqtt",
    "websocket",
    "unofficial",
    "goatbot",
    "mirai"
  ],
  "license": "MIT",
  "dependencies": {
    "mqtt": "4.3.8",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}