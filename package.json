{
  "name": "SunkenBot",
  "version": "5.0.0",
  "description": "SunkenBot v5.0 — modular aggregators + stable utils",
  "main": "main.js",
  "type": "module",
  "engines": {
    "bun": ">=1.3.4"
  },
  "scripts": {
    "build": "bun install --frozen-lockfile --production",
    "start": "bun --smol main.js",
    "dev": "bun --watch main.js",
    "build:rust": "cd rust && cargo build --locked --release",
    "test:rust": "bun scripts/test-rust.js",
    "parity:rust": "bun scripts/parity-test.js",
    "bench:rust": "bun scripts/bench-rust.js"
  },
  "overrides": {
    "cheerio": "^1.2.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fcanew-r3nz75": "^10.1.15",
    "fs-extra": "^11.3.6",
    "youtubei.js": "^18.2.0",
    "request": "npm:@cypress/request@4.0.1",
    "@vreden/youtube_scraper": "^1.2.9",
    "pg": "^8.16.3"
  },
  "_hardened": "fcanew-r3nz75 merged v4.0 — secureStore+mergeOnSave+rateLimiter+fca-lifecycle+monitor"
}
